# ===== Provider（Tier 0 起步只需一组；名字随意，与 providers.yaml 对上即可）=====
# 任意 OpenAI 兼容端点都可以。
PROVIDER_MAIN_API_KEY=sk-xxxxxxxxxxxxxxxx
PROVIDER_MAIN_BASE_URL=https://api.openai.com/v1
PROVIDER_MAIN_MODEL=your-vision-model

# 备用 provider（可选，加新模型就是再加一组，代码零改动）
PROVIDER_BACKUP_API_KEY=
PROVIDER_BACKUP_BASE_URL=
PROVIDER_BACKUP_MODEL=

# ===== 看片路径 =====
# 能吃视频的模型（videoread.py 整段读路径）：
VIDEO_READ_API_URL=https://api.openai.com/v1/chat/completions
VIDEO_READ_API_KEY=
VIDEO_READ_MODELS=your-vision-model
# 只吃图的模型 → 不配上面这组，走 scripts/bili_shot.py 抽帧路径即可

# ===== B站账号（Tier 1 起需要；mid 不是邮箱，是纯数字 ID）=====
# 自己账号的 mid（评论署名/消息筛选兜底）
BILI_MID_SELF=
# 主人/通知目标账号的 mid（私信默认对象，@ 目标在 mission 里配）
BILI_MID_OWNER=
# 登录态文件（格式见 docs/security-guide.md 的 cookie 一节；绝不提交进仓库）
BILI_COOKIES_PATH=~/.hermes/bili/cookies.json
# 数据根目录（账本/日志/缓存），支持多 profile 分号
BILI_HOME=~/.hermes/bili

# ===== 行为开关 =====
# cron 任务投递方式：local（只写本地记录）—— 原部署踩过 origin 静默外泄到聊天软件的坑，默认必须 local
HERMES_DELIVER=local
# 门禁模式：manual（macOS 菜单栏放行）/ time_window（纯配置时间窗）/ none（Tier 0 只读可关）
GUARDIAN_MODE=time_window
